APP_NAME=FieldwireDemo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL (create the database first, see README)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fieldwire_demo
DB_USERNAME=postgres
DB_PASSWORD=postgres

# We only use Redis for the Laravel queue
CACHE_STORE=redis
SESSION_DRIVER=file
QUEUE_CONNECTION=redis

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# predis is a pure-PHP Redis client, so no PHP redis extension is required
REDIS_CLIENT=predis
# must be larger than the job timeout (900s) so the job is never duplicated mid-run
REDIS_QUEUE_RETRY_AFTER=1800

# AWS S3 (demo only - no real credentials!)
# Create an S3 bucket and make objects under demo/plans/ publicly readable
# (or leave the bucket public for this local demo), see README -> S3 setup.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# never set in real life:
# AWS_ENDPOINT=http://127.0.0.1:4566        (LocalStack)
# AWS_USE_PATH_STYLE_ENDPOINT=true